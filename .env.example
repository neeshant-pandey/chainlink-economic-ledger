# Copy to .env and fill in. .env is gitignored.

# --- Ethereum RPC ---
# A trace-capable archive node is required for slashing reconciliation.
# Free options: Alchemy (free tier supports debug_traceTransaction on archive),
# Infura archive add-on, Quicknode trace add-on, or self-hosted erigon/reth.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_FALLBACK_URL=
CHAIN_ID=1

# --- Etherscan (optional — used by scripts/pull_chainlink_abis.py to populate
# config/abis/*.json and the topic0 values in config/contracts/*.yaml that are
# currently TBD). Free tier registration: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# --- GCP ---
GCP_PROJECT=chainlink-staking-ledger-dev
GCP_REGION=us-central1
GCS_BUCKET=chainlink-staking-ledger-raw
BQ_DATASET_RAW=staking_raw
BQ_DATASET_STAGING=staking_staging
BQ_DATASET_INTERMEDIATE=staking_intermediate
BQ_DATASET_MARTS=staking_marts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Pipeline knobs ---
FINALITY_DEPTH=64                   # blocks behind tip considered finalized
LOG_FETCH_WINDOW=2000               # initial eth_getLogs window
TRACE_PARALLELISM=4
RECEIPT_BATCH_SIZE=50

# --- Databricks (parity only) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_DELTA_PATH=s3://or-gcs/path/to/delta

# --- Monitoring ---
ALERT_WEBHOOK_URL=
METRICS_NAMESPACE=chainlink_staking_ledger
